{
  "name": "aurawebs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -p 3000",
    "css:build": "npx tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "css:watch": "npx tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "sitemap:dates": "node scripts/seo/sitemap-lastmod.mjs",
    "sitemap:check": "node scripts/seo/sitemap-lastmod.mjs --check",
    "partials:sync": "node scripts/sync-partials.mjs",
    "qa:serve": "python scripts/qa/serve.py 8765",
    "qa": "playwright-cli open about:blank && playwright-cli run-code --filename=scripts/qa/visual-check.js && playwright-cli close"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
